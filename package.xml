<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_nodered</name>
  <version>0.1.0</version>
  <description>讓 Node-RED 透過 ROS 2 控制無人機：起飛／盤旋／降落服務與對應的 Node-RED 流程</description>

  <maintainer email="oliver.920906@gmail.com">oliver</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>drone_nodered_interfaces</exec_depend>
  <!-- 流程要透過 rosbridge 跟 ROS 2 溝通，積木也來自這個套件 -->
  <exec_depend>nodered_ros2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
